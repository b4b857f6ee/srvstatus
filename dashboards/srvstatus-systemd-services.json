      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "format": "table",
          "query": "from(bucket: \"linux\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"services_stats\" and r._field == \"status\")\n  |> filter(fn: (r) => r.host =~ /^(${host:pipe})$/ and r.service =~ /^(${service:pipe})$/)\n  |> last()\n  // Une unite qui remontait et ne remonte plus depuis 5 min = \"Silence\" (9),\n  // signale en orange. A ne pas confondre avec \"n/a\" (jamais surveillee ici),\n  // qui reste neutre : c'est une absence d'information, pas une anomalie.\n  |> map(fn: (r) => ({ r with _value:\n       if (int(v: now()) - int(v: r._time)) > 300000000000 then 9.0\n       else float(v: r._value) }))\n  |> group()\n  |> pivot(rowKey: [\"service\"], columnKey: [\"host\"], valueColumn: \"_value\")\n  |> sort(columns: [\"service\"])",
