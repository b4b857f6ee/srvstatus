          "format": "table",
          "query": "from(bucket: \"linux\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"services_stats\")\n  |> filter(fn: (r) => r._field == \"status\" or r._field == \"status_time\")\n  |> filter(fn: (r) => r.host =~ /^(${host:pipe})$/ and r.service =~ /^(${service:pipe})$/)\n  |> last()\n  |> group()\n  |> pivot(rowKey: [\"host\", \"service\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> sort(columns: [\"status_time\"])\n  |> limit(n: 15)\n  |> keep(columns: [\"host\", \"service\", \"status\", \"status_time\"])",
          "refId": "A"
