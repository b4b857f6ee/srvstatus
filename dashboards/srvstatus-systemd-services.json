{
  "description": "Vue multi-hôtes de l'état des unités systemd (srvstatus). Code couleur : vert = Ok · orange = ne remonte plus, ou unité introuvable · rouge = arrêtée ou en échec · gris « n/a » = non surveillée sur cet hôte.",
  "editable": true,
  "panels": [
    {
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "description": "Ok tant qu'aucune unité n'est hors état « actif ».",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "green",
                  "index": 0,
                  "text": "Ok"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "from": 1,
                "result": {
                  "color": "red",
                  "index": 1,
                  "text": "ALERTE"
                },
                "to": 9999
              },
              "type": "range"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "from(bucket: \"linux\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"services_stats\" and r._field == \"status\")\n  |> filter(fn: (r) => r.host =~ /^(${host:pipe})$/ and r.service =~ /^(${service:pipe})$/)\n  |> last()\n  |> group()\n  |> map(fn: (r) => ({ r with _value:\n       if (int(v: now()) - int(v: r._time)) > 300000000000 then 1.0\n       else if float(v: r._value) == 1.0 then 0.0 else 1.0 }))\n  |> sum()",
          "refId": "A"
        }
      ],
      "title": "État global",
      "type": "stat"
    },
    {
      "datasource": {
